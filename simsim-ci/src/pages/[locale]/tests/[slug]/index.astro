---
import {locales} from '../../../../data/locales.mjs';
import {tests} from '../../../../data/tests.mjs';
export function getStaticPaths(){return locales.flatMap(locale=>tests.map(slug=>({params:{locale,slug}})));}
const {locale,slug}=Astro.params;
---
<html lang={locale} dir={locale==='ar'?'rtl':'ltr'}><head><title>{slug} | SimsimLAB</title>{locales.map(l=><link rel="alternate" hreflang={l} href={'/simsim-lab/'+l+'/tests/'+slug+'/'}/>)}<link rel="alternate" hreflang="x-default" href={'/simsim-lab/en/tests/'+slug+'/'}/></head><body><h1>{slug}</h1><p>8 questions · 5 results · shared engine</p></body></html>