---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getPack, localeCodes } from '../data/locales.mjs';
const { locale='en', title='SimsimLAB', description='', slug='', page='home', noindex=false }=Astro.props;
const p=getPack(locale); const base=import.meta.env.BASE_URL; const origin=Astro.site || new URL('https://501-studio.github.io');
const path= page==='test' ? `${base}${locale}/tests/${slug}/` : `${base}${locale}/`;
const canonical=new URL(path,origin).href; const og=new URL(`${base}og-default.svg`,origin).href;
---
<!doctype html>
<html lang={locale} dir={p.dir}>
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#7657ff"/>
<title>{title}</title><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex,nofollow"/>}
<link rel="canonical" href={canonical}/>
{localeCodes.map(l=><link rel="alternate" hreflang={l} href={new URL(page==='test'?`${base}${l}/tests/${slug}/`:`${base}${l}/`,origin).href}/>)}
<link rel="alternate" hreflang="x-default" href={new URL(page==='test'?`${base}en/tests/${slug}/`:`${base}en/`,origin).href}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="SimsimLAB"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={og}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={og}/>
<link rel="icon" href={`${base}favicon.svg`}/><link rel="manifest" href={`${base}site.webmanifest`}/>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<Header locale={locale} slug={slug} page={page}/>
<main id="main"><slot/></main>
<Footer locale={locale}/>
<div class="toast" data-toast role="status" aria-live="polite"></div>
<script define:vars={{base}}>window.__SIMSIM_BASE__=base;</script>
<script type="module" src={`${base}site.js`}></script>
</body></html>